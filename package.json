{
  "name": "electric-sheep",
  "version": "0.3.0",
  "description": "Evidence-driven evolution stress tests for coding agents",
  "type": "module",
  "bin": {
    "electric-sheep": "bin/electric-sheep.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "skills/",
    ".claude-plugin/",
    ".codex-plugin/",
    "scripts/package-local.mjs",
    "README.md",
    "docs/usage.md",
    "docs/verification.md",
    "examples/"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "format": "prettier --write \"{src,bin,scripts,tests}/**/*.mjs\" \"skills/**/*.mjs\" package.json .prettierrc.json",
    "format:check": "prettier --check \"{src,bin,scripts,tests}/**/*.mjs\" \"skills/**/*.mjs\" package.json .prettierrc.json"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
